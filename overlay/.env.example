# Shared committed `.env`: shared keys only. Never commit `.env.local` /
# `.env.prod` or secrets (VPS host files mode 0600).
# Compose interpolates ${VAR} from process env + `--env-file .env` then
# `.env.local` then `.env.prod` (if present). Shopware reads the same names
# at runtime.
#
# After `composer require`, Flex may append a ###> fyrst/shopware-cd ### block
# (SHOPWARE_SHOP_ID empty, SHOPWARE_DATA_BASE default). If that block still
# writes SHOPWARE_DEPLOY_ENV=live, leave it empty or omit it — a real value
# in shared `.env` would lock every host (identity keys cannot be overridden
# by later files). Host `.env.local` / `.env.prod` sets this host's role.
# That block is safe defaults only — no secrets. Finish shop-specific values with:
#   fyrst-cli shopware env init --shop-id <slug>
#   (install fyrst-cli 0.1.0+ on each VPS / laptop)
# env init strips create's COMPOSE_PROJECT_NAME from shared `.env` and writes
# SHOPWARE_DEPLOY_ENV + COMPOSE_PROJECT_NAME=<shop-id>-<env> (acme-dev /
# acme-live) to host `.env.local`. It also sets gitignored
# compose.override.yaml `name:` for shopware-cli project dev. Local and VPS
# use that same Compose project name — not folder basename, not
# shopware-<shop-id>. VPS Compose naming SoT is deploy/compose.yaml
# `name: ${SHOPWARE_SHOP_ID}-${SHOPWARE_DEPLOY_ENV}` with host env files
# loaded. fyrst-cli passes `--env-file .env` then `.env.local` then
# `.env.prod` (if present) and keeps `-p` only as a matching pin.
# Raw Compose must use those same `--env-file` flags (omit a flag if
# that host file is missing).
# Optional: --env live|staging|playground|dev  --image <registry/repo>  --dry-run
# env init copies this file → .env when .env is missing, then merges **missing**
# keys without clobbering existing non-empty values. It does not overwrite the
# whole .env, does not invent MYSQL passwords or APP_URL, and does not generate
# APP_SECRET (shopware-cli project create already writes it).
# First-install admin vars are consumed by shopware-deployment-helper only on a fresh DB.
#
# Compose source of truth: SHOPWARE_SHOP_ID (shared `.env`) + SHOPWARE_DEPLOY_ENV
# (host `.env.local` / `.env.prod`). Bind-mount paths come from those two
# (plus optional SHOPWARE_DATA_BASE). Do not put COMPOSE_PROJECT_NAME in
# shared `.env` — host `.env.local` holds COMPOSE_PROJECT_NAME=<shop-id>-<env>.
# SHOPWARE_DATA_ROOT stays optional.
# Nested defaults like ${ROOT:-/base/${SHOP_ID}/env} do not expand in Compose;
# compose.yaml concatenates separate interpolations instead.
# After recipe updates: composer recipes:update fyrst/shopware-cd
# then fyrst-cli shopware env init (or merge new keys from this file by hand).

# --- Image (CD Compose under deploy/ + CI) ----------------------------------
# SHOPWARE_PACKAGES_TOKEN is a CI secret, not a Compose variable. Set it only
# if the shop uses packages.shopware.com (empty is fine — not required).
# TODO: registry/repo for this shop, e.g. ghcr.io/fyrst-dev/shop-name
IMAGE=
IMAGE_TAG=latest
# shopware/docker copies docker/Dockerfile. Required — this recipe has no root Dockerfile.
DOCKERFILE=docker/Dockerfile
PHP_VERSION=8.3

# --- Shopware runtime -----------------------------------------------------------
APP_ENV=prod
# fyrst-cli shopware sync rewrite / destination reminder uses APP_URL only.
APP_URL=
APP_SECRET=
# Optional: INSTANCE_ID=

# mysql://USER:PASSWORD@HOST:3306/DATABASE
# Bundled service hostname is `mysql`. For DBaaS, use the provider host and
# remove/disable the `mysql` service in deploy/compose.yaml (CD/VPS stack).
# Local CLI compose is owned by `shopware-cli project create` (shop-root compose.yaml).
DATABASE_URL=
# DATABASE_SSL_CA=
# DATABASE_SSL_CERT=
# DATABASE_SSL_KEY=
# DATABASE_SSL_DONT_VERIFY_SERVER_CERT=

# --- Bundled MySQL service (compose service `mysql`) -----------------------
# Unused when DATABASE_URL points at an external database.
MYSQL_DATABASE=shopware
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- First install (deployment helper; ignored on updates) --------------------
INSTALL_LOCALE=en-GB
INSTALL_CURRENCY=EUR
INSTALL_ADMIN_USERNAME=
INSTALL_ADMIN_PASSWORD=
INSTALL_ADMIN_EMAIL=
# Defaults to APP_URL when empty
SALES_CHANNEL_URL=

# --- Optional Redis (compose profile `redis`) ------------------------------
# REDIS_URL=redis://redis:6379
# PHP_SESSION_HANDLER=redis
# PHP_SESSION_SAVE_PATH=tcp://redis:6379

# --- Shop identity (source of truth for Compose + scripts) -------------------
# Stable shop slug — same on live + staging + laptop (e.g. acme). Required.
# Shared committed `.env` only.
SHOPWARE_SHOP_ID=
# Stack role on THIS host — not a real value in shared `.env`.
# live | staging | playground | dev
# Host `.env.local` / `.env.prod` sets it (env init writes `.env.local`):
# SHOPWARE_DEPLOY_ENV=
# COMPOSE_PROJECT_NAME=<shop-id>-<env>   e.g. acme-dev / acme-live
#
# Local and VPS Compose project name is ${SHOPWARE_SHOP_ID}-${SHOPWARE_DEPLOY_ENV}
# (acme-dev / acme-live) — not folder basename, not shopware-<shop-id>.
# Host `.env.local` holds COMPOSE_PROJECT_NAME=<shop-id>-<env>. env init also
# sets gitignored compose.override.yaml `name:` for shopware-cli project dev.
# VPS Compose naming SoT is deploy/compose.yaml
# `name: ${SHOPWARE_SHOP_ID}-${SHOPWARE_DEPLOY_ENV}` with host env files
# loaded. fyrst-cli passes `--env-file .env` then `.env.local` then
# `.env.prod` (if present) and keeps `-p` only as a matching pin.
# Raw Compose must use those same `--env-file` flags (omit a flag if
# that host file is missing).
# Bind-mount data root still uses shop id + deploy env:
#   ${SHOPWARE_DATA_BASE:-/var/lib/shopware/data}/${SHOPWARE_SHOP_ID}/${SHOPWARE_DEPLOY_ENV}
#                 → /var/lib/shopware/data/acme/live
# Layout:  …/{files,media,thumbnail,theme,sitemap}
#          /var/lib/shopware/data/acme/live/media
#          /var/lib/shopware/data/acme/staging/media
# Named volumes mysql_data / redis_data on the VPS are prefixed by
# ${SHOPWARE_SHOP_ID}-${SHOPWARE_DEPLOY_ENV} (acme-live_mysql_data, …).
#
# Optional prefix (default /var/lib/shopware/data). Compose and scripts both
# read this. Set it only if data should live on another disk/path.
# SHOPWARE_DATA_BASE=/var/lib/shopware/data
#
# Optional expanded SHOPWARE_DATA_ROOT for scripts/docs/tools that need it.
# Leave unset: fyrst-cli derives the same formula. If set, it prefers this
# value. Do not assign COMPOSE_PROJECT_NAME= empty (that env var would
# override compose `name:`). If a previous overlay left SHOPWARE_DATA_ROOT=
# in `.env`, comment that line out.
#
# shopware-cli project create writes COMPOSE_PROJECT_NAME=sw-shop-…
# into the shop-root `.env`. fyrst-cli shopware env init --shop-id acme
# strips that line from shared `.env`, writes SHOPWARE_DEPLOY_ENV and
# COMPOSE_PROJECT_NAME=<shop-id>-<env> to host `.env.local`, and sets
# gitignored compose.override.yaml `name:`. Flex does **not** strip it on
# composer require — run env init. Do not put COMPOSE_PROJECT_NAME in
# shared `.env`.
# SHOPWARE_DATA_ROOT=/var/lib/shopware/data/acme/live
#
# Bootstrap once per shop+env on the VPS (uid 82 = www-data in docker-base):
#   DATA="${SHOPWARE_DATA_BASE:-/var/lib/shopware/data}/${SHOPWARE_SHOP_ID}/${SHOPWARE_DEPLOY_ENV}"
#   mkdir -p "${DATA}"/{files,media,thumbnail,theme,sitemap}
#   chown -R 82:82 "${DATA}"

# --- Optional HTTP publish (local / VPS behind a reverse proxy) ---------------
HTTP_PORT=8000
# Prod overlay (deploy/compose.prod.yaml) binds loopback. Unsupported live override:
# HTTP_BIND=0.0.0.0

# --- Optional VPS smoke check (fyrst-cli shopware deploy release) ------------
# SMOKE_URL=http://127.0.0.1:8000
# Unset ROLLBACK_ON_SMOKE_FAIL → auto-rollback on live, off otherwise.
# ROLLBACK_ON_SMOKE_FAIL=1

# --- VPS image pull (deploy/compose.vps.yaml) --------------------------------
# Default pull_policy is always (CI/VPS after CI pushed IMAGE:IMAGE_TAG).
# Same-host tag-and-load / air-gap never pushed that tag, so pull fails.
#   PULL_POLICY=never
#   SKIP_PULL=1            # also skip `docker compose pull` in deploy release
#                           # same as: fyrst-cli shopware deploy release --skip-pull
# Leave unset on a real VPS that should pull from the registry.
# PULL_POLICY=never

# --- Compose profiles (VPS) --------------------------------------------------
# Recommended live default. Uncomment on the live host (`.env.local` /
# `.env.prod`) so messenger + scheduled-task (and Redis if you use it)
# actually start. fyrst-cli shopware deploy release WARNS when
# SHOPWARE_DEPLOY_ENV=live and this is empty; it does not auto-enable.
# Leave commented on staging unless you intentionally need worker/scheduler.
# COMPOSE_PROFILES=redis,worker,scheduler

# --- SSH / backup / live gate (fyrst-cli; shop-root .env.*) -----------------
# Shared `.env`, then `.env.local` (this host's SHOPWARE_DEPLOY_ENV,
# COMPOSE_PROJECT_NAME=<shop-id>-<env>, laptop SSH / extras), then `.env.prod`
# (VPS) is the only source of truth. Later file wins. Identity keys already
# set in an earlier file cannot be overridden — do not lock
# SHOPWARE_DEPLOY_ENV in shared `.env`. Object storage is out of scope.
# Sync is not a backup.
#
# CI GitHub/GitLab secrets (VPS_HOST, VPS_USER, VPS_PATH, SSH_PRIVATE_KEY)
# stay secrets — do not copy them here.
#
# Laptop → live SSH: put this trio in `.env.local`. Host defaults to the
# sync alias (`live` → ~/.ssh/config `Host live`) when unset.
# SHOPWARE_SSH_HOST=
# SHOPWARE_SSH_USER=
# SHOPWARE_SSH_KEY=
#
# Optional remote live data root. Unset →
# /var/lib/shopware/data/$SHOPWARE_SHOP_ID/live
# SHOPWARE_REMOTE_DATA_ROOT=
#
# Backup (usually on live). Default target is local. Set a second disk or
# SSH host so the copy survives disk loss. Reuse SHOPWARE_SSH_* for SSH
# targets. Dump stays shopware-cli; fyrst-cli copies BACKUP_DB_DUMP.
# BACKUP_TARGET=local
# BACKUP_KEEP_DAYS=14
# BACKUP_DB_DUMP=/tmp/db.sql.gz
#
# One live gate for `sync apply` and `backup recover` (plus --allow-live).
# Do not set this in cron.
# SHOPWARE_ALLOW_LIVE_RESTORE=1
